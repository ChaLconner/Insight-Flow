# Database Configuration - Neon PostgreSQL
DATABASE_URL=postgresql://user:password@endpoint-pooler.region.aws.neon.tech/neondb?sslmode=require

# JWT Configuration
# SECURITY: Generate a secure key using: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_THIS_TO_SECURE_RANDOM_KEY_MIN_32_CHARS
ALGORITHM=HS256

# Token Expiration (A+ Security Settings)
# Access token: Short-lived (30 minutes recommended)
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Refresh token: Medium-lived (7-14 days recommended)
REFRESH_TOKEN_EXPIRE_DAYS=7

# Token Fingerprinting (Device Binding)
# TOKEN_FINGERPRINT_ENABLED=true
# TOKEN_FINGERPRINT_STRICTNESS=normal  # lenient, normal, strict

# IP Blocking for Rate Limit Violations
# IP_BLOCK_THRESHOLD=10
# IP_BLOCK_INITIAL_MINUTES=15
# IP_BLOCK_MAX_HOURS=24
# IP_WHITELIST=127.0.0.1,::1


# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here

# GitHub OAuth Configuration
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
NEXT_PUBLIC_GITHUB_CLIENT_ID=your_github_client_id_here

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8000

# Environment (development or production)
ENVIRONMENT=development

# CORS Origins (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Allowed Hosts for TrustedHostMiddleware (comma-separated)
# IMPORTANT: Must include your Render domain in production!
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,testserver

# Debug mode
# SECURITY: NEVER set DEBUG=true in production!
DEBUG=false

# Cloudinary Configuration (for avatar/file uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Redis Configuration (for distributed caching in production)
# Leave empty or comment out for in-memory cache (development)
# Example: redis://localhost:6379/0 or redis://user:password@redis-host:6379/0
REDIS_URL=redis://localhost:6379/0

# Cache Configuration
CACHE_ENABLED=true
CACHE_DEFAULT_TIMEOUT=300

# Database Performance (Optional)
# DB_POOL_SIZE=20
# DB_MAX_OVERFLOW=20
# DB_POOL_TIMEOUT=30
# DB_POOL_RECYCLE=300
# DB_STATEMENT_TIMEOUT_MS=30000
# DB_SLOW_QUERY_THRESHOLD_MS=1000

# Rate Limiting (requests per minute)
# RATE_LIMIT_CALLS=200
# RATE_LIMIT_PERIOD=60

# Stripe Payment Gateway Configuration
# SECURITY: Get keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_CHANGE_THIS_TO_YOUR_STRIPE_SECRET_KEY
STRIPE_PUBLISHABLE_KEY=pk_test_CHANGE_THIS_TO_YOUR_STRIPE_PUBLISHABLE_KEY
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_THIS_TO_YOUR_WEBHOOK_SECRET

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=CHANGE_THIS_TO_YOUR_APP_PASSWORD
SENDER_EMAIL=your_email@gmail.com
FRONTEND_URL=http://localhost:3000
