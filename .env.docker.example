# ===========================================
# Docker Environment Variables Example
# ===========================================
# Copy this file to .env.docker and configure your values
# NEVER commit .env.docker to version control

# Database Configuration
POSTGRES_USER=insightflow
# SECURITY: Use a strong password with at least 16 characters
POSTGRES_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD_MIN_16_CHARS
POSTGRES_DB=insightflow
DATABASE_URL=postgresql+pg8000://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# Security
# SECURITY: Generate a secure key using: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_THIS_TO_SECURE_RANDOM_KEY_MIN_32_CHARS

# CORS Configuration
CORS_ORIGINS=http://localhost:3000

# Host Configuration
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Frontend Configuration
NODE_ENV=production
API_URL=http://backend:8000

# Environment
ENVIRONMENT=production
APP_DEBUG=false

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# Stripe Configuration
# SECURITY: Get keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_CHANGE_THIS_TO_YOUR_STRIPE_SECRET_KEY
STRIPE_PUBLISHABLE_KEY=pk_live_CHANGE_THIS_TO_YOUR_STRIPE_PUBLISHABLE_KEY
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_THIS_TO_YOUR_WEBHOOK_SECRET

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# OAuth Configuration
# SECURITY: Get credentials from Google Cloud Console
GOOGLE_CLIENT_ID=CHANGE_THIS_TO_YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=CHANGE_THIS_TO_YOUR_GOOGLE_CLIENT_SECRET
# SECURITY: Get credentials from GitHub Developer Settings
GITHUB_CLIENT_ID=CHANGE_THIS_TO_YOUR_GITHUB_CLIENT_ID
GITHUB_CLIENT_SECRET=CHANGE_THIS_TO_YOUR_GITHUB_CLIENT_SECRET

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=CHANGE_THIS_TO_YOUR_APP_PASSWORD
SENDER_EMAIL=your_email@gmail.com
