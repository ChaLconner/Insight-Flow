# API Configuration
# For local development:
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
API_URL=http://127.0.0.1:8000

# Backend debug flag uses APP_DEBUG to avoid collisions with generic DEBUG env vars.
APP_DEBUG=false

# For production (set in Vercel Environment Variables):
# NEXT_PUBLIC_APP_URL=https://insight-flow-iota.vercel.app
# API_URL=https://your-backend-url.onrender.com
# GITHUB_REDIRECT_URI=https://insight-flow-iota.vercel.app/auth/callback/github

# Google OAuth
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here

# GitHub OAuth
NEXT_PUBLIC_GITHUB_CLIENT_ID=your_github_client_id_here

# Stripe Payment Gateway (public key only - safe for frontend)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
