      "args": [
        "-y",
        "@upstash/context7-mcp"
      ],
      "env": {
        "DEFAULT_MINIMUM_TOKENS": "10000"
      },
      "alwaysAllow": [
        "resolve-library-id",
        "get-library-docs"
