{
  "name": "insight-flow",
  "version": "1.0.0",
  "description": "A modern project management platform",
  "main": "index.js",
  "scripts": {
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && uvicorn main:app --reload",
    "dev": "concurrently --names \"BACKEND,FRONTEND\" --colors \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build": "cd frontend && npm run build",
    "start": "cd backend && python start.py",
    "lint": "cd frontend && npm run lint",
    "lint:fix": "cd frontend && npm run lint:fix",
    "lint:check": "cd frontend && npm run lint:check",
    "test": "npm run test:frontend && npm run test:backend",
    "test:frontend": "cd frontend && npm test",
    "test:backend": "cd backend && pytest",
    "type-check": "cd frontend && npm run type-check",
    "check:all": "npm run type-check && npm run lint:check && npm run test"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
